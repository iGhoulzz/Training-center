{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "Stop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "php",
                        "args": [
                            "${CLAUDE_PROJECT_DIR}/scripts/bin/agent-stop.php"
                        ],
                        "timeout": 300
                    }
                ]
            }
        ]
    }
}
