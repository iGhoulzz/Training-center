APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training_center
DB_USERNAME=training_center
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Production uses Redis so receipts and report exports run on supervised queue
# workers. A development machine without Redis may explicitly set this back to
# database; that fallback is not a production configuration.
QUEUE_CONNECTION=redis

# Deliberately database-backed. Moving the cache to Redis is a separate
# operational decision, not part of the queue requirement.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backups (P1-T13, destination made selectable in P1-T17). REQUIRED in
# production — the application refuses to boot without a working destination,
# because a nightly backup that stores nothing looks exactly like a healthy one
# until a restore is needed.
#
# WHICH DESTINATION. backups_local writes to a removable drive; backups_s3
# writes to S3-compatible storage. Both are configured below, so switching later
# is this one line and nothing else.
BACKUP_DISK=backups_local

# --- backups_local: a removable or external drive -------------------------
#
# The mount point of the drive, NOT a folder inside this project. The
# application refuses to boot in production if this path sits inside its own
# directory, because an archive on the disk it protects dies with that disk.
#
# WHETHER THE DRIVE IS PLUGGED IN is checked by backup:run, backup:monitor and
# backup:clean, not at boot. An unplugged drive must never stop the centre from
# working, so it fails those three commands — however they were started — and
# each sends its own alert to BACKUP_ALERT_EMAIL. The application keeps serving.
#
# That check is what catches the unmounted-drive case: without it the nightly run
# writes into an empty mount point on the server, the monitor finds those files
# and reports healthy, and the drive somebody carries off-site stays empty.
#
# WHAT NO CHECK CAN DO FOR YOU. Nothing here can tell whether the drive is
# genuinely removable, whether it is still plugged in tomorrow, or whether
# anybody takes it off the premises. A drive that never leaves the building
# survives a dead server and not a fire. Rotate two drives if the data matters.
BACKUP_LOCAL_PATH=/mnt/backups

# A file that must exist on the drive before anything is written to it. This is
# the second question device identity cannot answer: a mounted drive is SOME
# drive, not necessarily the one prepared for these backups. Create it once per
# drive, and a rotated-in stranger's disk is refused rather than filled:
#
#   touch /mnt/backups/.training-center-backup-volume
#
# Set it empty to switch the check off.
BACKUP_VOLUME_MARKER=.training-center-backup-volume

# --- backups_s3: S3-compatible object storage ------------------------------
#
# Unused while BACKUP_DISK=backups_local, and kept configured so moving to it is
# a one-line change. Any S3-compatible provider works: Backblaze B2, Wasabi,
# DigitalOcean Spaces, Hetzner, MinIO.
#
# THE ENDPOINT IS REQUIRED, including on AWS itself. Left blank it constructs
# without complaint and the SDK resolves to a regional AWS host — so a Backblaze
# deployment would ship its archives to AWS with credentials that cannot
# authenticate, and nothing would say so until a restore. On AWS, write the
# regional endpoint explicitly: https://s3.eu-west-1.amazonaws.com
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=true

# AES-256 archive encryption. The archive holds the whole database and every
# scanned identity document, so this is required in production.
# LOSING IT MAKES EVERY BACKUP UNREADABLE — store it in a password manager, not
# only here: this file lives on the server the backup exists to survive.
BACKUP_ARCHIVE_PASSWORD=

# The directory inside the bucket, and the prefix on every archive filename.
#
# DO NOT CHANGE THIS ON A LIVE DEPLOYMENT WITHOUT MIGRATING THE BUCKET.
# Changing it starts a NEW directory: tonight's backup succeeds, the monitor
# looks in the new place and reports healthy, cleanup never sees the old
# directory again, and every archive already written is orphaned — retention
# effectively resets to one night, silently. To rename, move or copy the
# existing directory in the bucket FIRST, then change this value.
#
# It is a setting of its own precisely so that cannot happen by accident: it
# used to follow APP_NAME, where an ordinary cosmetic rename had exactly the
# effect described above.
BACKUP_ARCHIVE_NAME=training-center

# What one nightly archive weighs, in megabytes — the database plus both upload
# roots, compressed and encrypted.
#
# Only the storage health check reads this: it sizes the alert threshold from
# the retention tiers, so a figure far below reality makes the nightly check
# fail for ever about a system working exactly as designed, and people learn to
# ignore backup alerts.
#
# MEASURE IT AND SET IT. After the first few nights, look at the actual archive
# sizes in the bucket and put a realistic number here — the default is a
# starting guess, not a measurement. Raise it as the centre accumulates scanned
# documents.
BACKUP_EXPECTED_ARCHIVE_MB=250

# Where backup failures and unhealthy-backup warnings are sent.
#
# Falls back to MAIL_FROM_ADDRESS when blank OR unset, so a fresh checkout boots
# and every backup command runs. That fallback is deliberate: the package
# validates this address at boot and rejects an empty one, so leaving it blank
# without a fallback stopped the whole application rather than merely disabling
# alerts.
#
# Point it at a mailbox somebody actually reads before relying on it. The default
# `log` mailer writes notifications to a file and tells nobody, so a production
# deployment also needs a real MAIL_MAILER — otherwise backup:monitor notices a
# missing backup and the warning goes nowhere.
BACKUP_ALERT_EMAIL=

# Boost project rules stay off: this repo already has CLAUDE.md, AGENTS.md,
# docs/ENGINEERING.md and the design spec as authoritative sources, and a fifth
# location that agents write to unprompted would compete with them.
BOOST_RULES_ENABLED=false
