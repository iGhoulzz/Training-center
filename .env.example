APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=training_center
DB_USERNAME=training_center
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Off-server backups (P1-T13). REQUIRED in production — the application refuses
# to boot without them, because a nightly backup that stores nothing looks
# exactly like a healthy one until a restore is needed.
#
# Any S3-compatible provider works: Backblaze B2, Wasabi, DigitalOcean Spaces,
# Hetzner, MinIO. Set the endpoint for your provider.
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=true

# AES-256 archive encryption. The archive holds the whole database and every
# scanned identity document, so this is required in production.
# LOSING IT MAKES EVERY BACKUP UNREADABLE — store it in a password manager, not
# only here: this file lives on the server the backup exists to survive.
BACKUP_ARCHIVE_PASSWORD=

# The directory inside the bucket, and the prefix on every archive filename.
#
# DO NOT CHANGE THIS ON A LIVE DEPLOYMENT WITHOUT MIGRATING THE BUCKET.
# Changing it starts a NEW directory: tonight's backup succeeds, the monitor
# looks in the new place and reports healthy, cleanup never sees the old
# directory again, and every archive already written is orphaned — retention
# effectively resets to one night, silently. To rename, move or copy the
# existing directory in the bucket FIRST, then change this value.
#
# It is a setting of its own precisely so that cannot happen by accident: it
# used to follow APP_NAME, where an ordinary cosmetic rename had exactly the
# effect described above.
BACKUP_ARCHIVE_NAME=training-center

# What one nightly archive weighs, in megabytes — the database plus both upload
# roots, compressed and encrypted.
#
# Only the storage health check reads this: it sizes the alert threshold from
# the retention tiers, so a figure far below reality makes the nightly check
# fail for ever about a system working exactly as designed, and people learn to
# ignore backup alerts.
#
# MEASURE IT AND SET IT. After the first few nights, look at the actual archive
# sizes in the bucket and put a realistic number here — the default is a
# starting guess, not a measurement. Raise it as the centre accumulates scanned
# documents.
BACKUP_EXPECTED_ARCHIVE_MB=250

# Where backup failures and unhealthy-backup warnings are sent.
#
# Falls back to MAIL_FROM_ADDRESS when blank OR unset, so a fresh checkout boots
# and every backup command runs. That fallback is deliberate: the package
# validates this address at boot and rejects an empty one, so leaving it blank
# without a fallback stopped the whole application rather than merely disabling
# alerts.
#
# Point it at a mailbox somebody actually reads before relying on it. The default
# `log` mailer writes notifications to a file and tells nobody, so a production
# deployment also needs a real MAIL_MAILER — otherwise backup:monitor notices a
# missing backup and the warning goes nowhere.
BACKUP_ALERT_EMAIL=
