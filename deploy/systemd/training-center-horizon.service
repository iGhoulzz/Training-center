[Unit]
Description=Training Center Horizon
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=training-center
Group=www-data
WorkingDirectory=/srv/training-center/current
ExecStart=/usr/bin/php -d memory_limit=128M /srv/training-center/current/artisan horizon
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=3600
UMask=0007
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
