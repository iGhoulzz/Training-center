[Unit]
Description=Training Center Pulse server health
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/srv/training-center/current
ExecStart=/usr/bin/php -d memory_limit=128M /srv/training-center/current/artisan pulse:check
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60
UMask=0007
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
