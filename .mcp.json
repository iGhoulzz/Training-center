{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "-r",
                "$d=getcwd();while(!is_file($d.'/scripts/bin/boost-mcp.php')&&dirname($d)!==$d)$d=dirname($d);require $d.'/scripts/bin/boost-mcp.php';"
            ],
            "env": {
                "BOOST_RULES_ENABLED": "false"
            }
        }
    }
}
