{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "-r",
                "require (getenv('CLAUDE_PROJECT_DIR') ?: getcwd()) . '/scripts/bin/boost-mcp.php';"
            ],
            "env": {
                "BOOST_RULES_ENABLED": "false"
            }
        }
    }
}
